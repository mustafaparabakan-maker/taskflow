{
  "info": {
    "name": "TaskFlow API",
    "description": "TaskFlow Görev Yönetim API'si - CRUD testleri",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "taskId", "value": "1" }
  ],
  "item": [
    {
      "name": "1 - Görev Ekleme",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Durum kodu 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Görev oluşturuldu', () => pm.expect(json.data.id).to.exist);",
              "pm.collectionVariables.set('taskId', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Login sayfası API'si\",\n  \"description\": \"Kullanıcı girişi için endpoint yazılacak\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\",\n  \"project\": \"TaskFlow\"\n}"
        }
      }
    },
    {
      "name": "2 - Görev Listeleme",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Durum kodu 200', () => pm.response.to.have.status(200));",
              "pm.test('Liste dizi olarak dönüyor', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "3 - Görev Detayı",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Durum kodu 200', () => pm.response.to.have.status(200));",
              "pm.test('Doğru görev geldi', () => pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('taskId'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "4 - Görev Güncelleme",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Durum kodu 200', () => pm.response.to.have.status(200));",
              "pm.test('Durum güncellendi', () => pm.expect(pm.response.json().data.status).to.eql('in-progress'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in-progress\",\n  \"priority\": \"medium\"\n}"
        }
      }
    },
    {
      "name": "5 - Görev Silme",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Durum kodu 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "6 - Hata: Başlıksız Görev (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] },
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"title yok\"\n}" }
      }
    },
    {
      "name": "7 - Hata: Olmayan Görev (404)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks/9999", "host": ["{{baseUrl}}"], "path": ["tasks", "9999"] }
      }
    }
  ]
}
